{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [
    "scope:api",
    "type:app"
  ],
  "targets": {
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/api/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/api/patches",
        "{workspaceRoot}/dist/apps/api/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/api/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "build": {
      "dependsOn": [
        "prisma-generate",
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "prisma-generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "prisma-generate"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "prisma-generate"
      ]
    },
    "prisma-generate": {
      "command": "prisma generate --config apps/api/prisma.config.ts",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma.config.ts"
      ],
      "outputs": [
        "{projectRoot}/src/generated/prisma"
      ]
    },
    "prisma-migrate": {
      "command": "prisma migrate dev --config apps/api/prisma.config.ts"
    },
    "prisma-deploy": {
      "command": "prisma migrate deploy --config apps/api/prisma.config.ts"
    },
    "prisma-seed": {
      "command": "prisma db seed --config apps/api/prisma.config.ts"
    },
    "prisma-studio": {
      "command": "prisma studio --config apps/api/prisma.config.ts",
      "continuous": true
    }
  }
}
