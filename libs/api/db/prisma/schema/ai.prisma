// Per-user AI services (libs/api/ai): OpenAI-compatible chat, text-to-speech and
// speech-to-text. Without them, AI features are off for that user. Keys are
// AES-256-GCM encrypted (never returned to the browser).

model UserAiSettings {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatUrl   String?  @db.VarChar(500)
  chatModel String?  @db.VarChar(100)
  chatKey   String?  @db.VarChar(1000)
  ttsUrl    String?  @db.VarChar(500)
  ttsModel  String?  @db.VarChar(100)
  /// Second voice (dialogues), e.g. a male voice
  ttsModel2 String?  @db.VarChar(100)
  ttsKey    String?  @db.VarChar(1000)
  sttUrl    String?  @db.VarChar(500)
  sttModel  String?  @db.VarChar(100)
  sttKey    String?  @db.VarChar(1000)
  /// Model names used before, most recent first (owner: pick an old one back).
  chatModels String[] @default([])
  ttsModels  String[] @default([])
  sttModels  String[] @default([])
  /// HTTP proxy per service (owner, 2026-11-03): on/off and its url, kept while off.
  chatProxyOn Boolean @default(false)
  chatProxy   String? @db.VarChar(500)
  ttsProxyOn  Boolean @default(false)
  ttsProxy    String? @db.VarChar(500)
  sttProxyOn  Boolean @default(false)
  sttProxy    String? @db.VarChar(500)
  /// ElevenLabs instead of an OpenAI-compatible api (owner, 2026-11-03); tts and stt only.
  ttsEleven   Boolean @default(false)
  sttEleven   Boolean @default(false)
  /// Deepgram instead of an OpenAI-compatible api (owner, 2026-11-03); tts and stt only.
  ttsDeepgram Boolean @default(false)
  sttDeepgram Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@map("user_ai_settings")
}

/// Saved AI service setups the user can switch back to (owner, 2026-11-02): one row per
/// "save" of a section. Keys are sealed like UserAiSettings and never sent to the browser.
model UserAiPreset {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// chat | tts | stt
  kind      String   @db.VarChar(10)
  url       String   @db.VarChar(500)
  model     String   @db.VarChar(100)
  model2    String?  @db.VarChar(100)
  key       String?  @db.VarChar(1000)
  /// Proxy url the setup goes through; null = direct.
  proxy     String?  @db.VarChar(500)
  elevenlabs Boolean @default(false)
  deepgram   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@map("user_ai_presets")
}

/// Operator-owned AI configuration; secrets inside the snapshot stay sealed.
model ManagedAiConfiguration {
  id Int @id
  settings Json

  @@map("managed_ai_configuration")
}

model ManagedAiPreset {
  id        String   @id @default(uuid(7)) @db.Uuid
  kind      String   @db.VarChar(10)
  url       String   @db.VarChar(500)
  model     String   @db.VarChar(100)
  model2    String?  @db.VarChar(100)
  key       String?  @db.VarChar(1000)
  proxy     String?  @db.VarChar(500)
  elevenlabs Boolean @default(false)
  deepgram   Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@map("managed_ai_presets")
}

/// AI use per account and Tehran calendar day (quotas, cost overview). chat units = tokens, tts = characters,
/// stt = recordings (units equal calls).
model AiUsageDay {
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  /// chat | tts | stt
  kind   String   @db.VarChar(10)
  calls  Int      @default(0)
  units  Int      @default(0)
  /// chat only: the output (completion) tokens included in `units`, priced apart.
  outputUnits Int  @default(0)
  /// Access tier at the latest recorded call (trial | earned | paid | staff), for cost per plan.
  tier   String?  @db.VarChar(10)

  @@id([userId, day, kind])
  @@index([day])
  @@map("ai_usage_days")
}

