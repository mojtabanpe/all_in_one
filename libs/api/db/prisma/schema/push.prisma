model PushSubscription {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  /// WEB uses VAPID keys; ANDROID/MACOS use an FCM registration token.
  platform String @default("WEB") @db.VarChar(10)
  fcmToken String?
  language String @default("fa") @db.VarChar(2)
  sessionVersion Int
  createdAt DateTime @default(now())
  deliveries PushDelivery[]
  @@index([userId])
  @@map("push_subscriptions")
}

model PushDelivery {
  subscriptionId String @db.Uuid
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  key String
  createdAt DateTime @default(now())
  @@id([subscriptionId, key])
  @@index([createdAt])
  @@map("push_deliveries")
}

/// One daily reminder shared across the user's subscribed devices.
model ReviewReminderSetting {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// On by default (directive 180): sent only when the account has cards due.
  enabled Boolean @default(true)
  time String @default("20:00") @db.VarChar(5)
  @@map("review_reminder_settings")
}

model ProgressNotificationSetting {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// All on by default (directive 180); the account page turns each off.
  firstWeek Boolean @default(true)
  weekly Boolean @default(true)
  /// Morning digest of today's open tasks, at a Tehran wall-clock time.
  dailyTasks Boolean @default(true)
  dailyTasksTime String @default("10:00")
  /// Informational account SMS (directive 150) for accounts without a push device.
  sms Boolean @default(true)

  @@map("progress_notification_settings")
}

/// One informational SMS of each kind per account, ever (directives 148 and 150).
model SmsNotice {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String @db.VarChar(32)
  createdAt DateTime @default(now())

  @@id([userId, kind])
  @@map("sms_notices")
}

/// A running Pomodoro's deadline survives suspended browsers and API restarts.
model FocusPushTimer {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  dueAt DateTime
  @@index([dueAt])
  @@index([userId])
  @@map("focus_push_timers")
}

/// An Android app (shell 1.0.6+) that schedules reminders on the device (directive 175). The server never sees those
/// notifications, so each schedule fetch is recorded here: one row per account and app build. Only the build and
/// times are kept, never a device identifier.
model LocalReminderDevice {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `bazaar`, `myket` or `direct_apk`.
  client String @db.VarChar(16)
  firstAt DateTime @default(now())
  lastAt DateTime @default(now())
  /// Reminders in the last schedule sent to the device.
  reminders Int @default(0)

  @@id([userId, client])
  @@index([lastAt])
  @@map("local_reminder_devices")
}
