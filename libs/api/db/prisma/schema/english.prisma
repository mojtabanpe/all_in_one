// Applet: english-learning (libs/applets/english-learning), ported from Recall.

/// A user's deck of flashcards.
model EnglishDeck {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String        @db.VarChar(200)
  description String        @default("")
  /// amber | rose | sage | sky | violet | clay
  color       String        @default("sky") @db.VarChar(16)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cards       EnglishCard[]

  @@index([userId, createdAt])
  @@map("english_decks")
}

/// A flashcard with its SM-2 state and Leitner leech counters.
model EnglishCard {
  id             String      @id @default(uuid(7)) @db.Uuid
  deckId         String      @db.Uuid
  deck           EnglishDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userId         String      @db.Uuid
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  front          String
  back           String
  /// Unit badge such as "u19".
  unit           String      @default("") @db.VarChar(16)
  /// Markdown list, revealed on request.
  examples       String      @default("")
  easeFactor     Float       @default(2.5)
  intervalDays   Int         @default(0)
  repetitions    Int         @default(0)
  lapses         Int         @default(0)
  suspended      Boolean     @default(false)
  suspensions    Int         @default(0)
  dueAt          DateTime    @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, deckId, dueAt])
  @@map("english_cards")
}

/// A reading passage (the user's own or AI-written).
model EnglishText {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String    @db.VarChar(200)
  body       String
  ai         Boolean   @default(false)
  /// 1–5 stars for AI texts; steers the next AI text.
  rating     Int?      @db.SmallInt
  reviewNote String    @default("")
  ratedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@map("english_texts")
}

/// Reviews per day, for the streak flame.
model EnglishReviewDay {
  userId  String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  reviews Int      @default(0)

  @@id([userId, date])
  @@map("english_review_days")
}
