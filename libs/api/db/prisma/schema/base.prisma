// Prisma schema (multi-file: every *.prisma in this folder). After a change run:
//   pnpm nx run api-db:prisma-migrate --name=<change>

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Null for an account made with a confirmed phone alone (directive 119).
  email        String?  @unique
  name         String?
  /// Null until a phone-only account sets a password.
  passwordHash String?
  role         Role     @default(CUSTOMER)
  /// Null until the user opens the confirmation link (directive 21).
  emailVerifiedAt DateTime?
  /// Iranian mobile in E.164 (`+989…`), set only after its SMS code was confirmed.
  phone           String?   @unique @db.VarChar(16)
  phoneVerifiedAt DateTime?
  /// Bumped on password change/reset; sessions carrying an older value are rejected.
  sessionVersion  Int       @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  onboardingGoal String? @db.VarChar(16)
  onboardingSkipped Boolean @default(false)
  onboardingCompletedAt DateTime?
  onboardingGoalChanges OnboardingGoalChange[]

  pushSubscriptions PushSubscription[]
  reviewReminder ReviewReminderSetting?
  progressNotification ProgressNotificationSetting?
  passwordResets     PasswordReset[]
  phoneCodes         PhoneCode[]
  emailVerifications EmailVerification[]
  mcpKeys            McpKey[]
  billingOrders       BillingOrder[]
  billingSubscription BillingSubscription?
  billingRewards BillingReward[] @relation("BillingRewardUser")
  billingRewardsGranted BillingReward[] @relation("BillingRewardAdmin")
  billingRewardRequests BillingRewardRequest[]
  billingAdjustments  BillingAdjustment[] @relation("BillingAdjustmentUser")
  billingAdjustmentsMade BillingAdjustment[] @relation("BillingAdjustmentAdmin")
  billingRefundsMade     BillingRefund[]     @relation("BillingRefundAdmin")

  // Applets (each applet's models live in its own schema file)
  plannerTasks          PlannerTask[]          @relation("PlannerTaskCreator")
  plannerAssigned       PlannerTask[]          @relation("PlannerTaskAssignee")
  plannerLists          PlannerList[]
  plannerMemberships    PlannerListMember[]
  plannerFolders        PlannerFolder[]
  plannerTags           PlannerTag[]
  plannerComments       PlannerComment[]
  plannerHabitSections  PlannerHabitSection[]
  plannerHabits         PlannerHabit[]
  plannerFocuses        PlannerFocus[]
  plannerCalendars      PlannerCalendar[]
  plannerCountdowns     PlannerCountdown[]
  englishDecks    EnglishDeck[]
  englishCards    EnglishCard[]
  englishTexts    EnglishText[]
  englishDays     EnglishReviewDay[]
  englishPracticeScores EnglishPracticeScore[]
  healthProfile   HealthProfile?
  workoutLogs     WorkoutLog[]
  healthRoutines  HealthRoutine[]
  healthWeights   HealthWeightLog[]
  healthFasts     HealthFast[]
  mealLogs        MealLog[]
  mealPlans       MealPlan[]
  aiSettings      UserAiSettings?
  aiPresets UserAiPreset[]
  aiUsage   AiUsageDay[]

  @@map("users")
}

/// Single-use password reset link (1 hour); only the token's SHA-256 is stored.
model PasswordReset {
  tokenHash String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@map("password_resets")
}

enum PhoneCodePurpose {
  /// Confirm a new number for the account (AUTH_CODE template).
  VERIFY
  /// Reset the password with a code sent to the verified number (PASSWORD_RESET template).
  RESET
}

/// The latest SMS code per account and purpose; only its SHA-256 is stored. `sends` counts codes sent since
/// `windowStart` (a daily cap), `attempts` wrong guesses of the current code.
model PhoneCode {
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     PhoneCodePurpose
  phone       String           @db.VarChar(16)
  codeHash    String
  expiresAt   DateTime
  attempts    Int              @default(0)
  sentAt      DateTime
  sends       Int              @default(1)
  windowStart DateTime

  @@id([userId, purpose])
  @@map("phone_codes")
}

/// Sign-in/sign-up code by SMS (LOGIN_CODE template), keyed by the number because the account may not exist yet.
/// Only the code's hash is stored; the same cooldown and daily cap as PhoneCode.
model SmsLoginCode {
  phone       String   @id @db.VarChar(16)
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  sentAt      DateTime
  sends       Int      @default(1)
  windowStart DateTime

  @@map("sms_login_codes")
}

/// Single-use email confirmation link (24 hours); only the token's SHA-256 is stored.
model EmailVerification {
  tokenHash String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@map("email_verifications")
}
