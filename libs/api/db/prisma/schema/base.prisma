// Prisma schema (multi-file: every *.prisma in this folder). After a change run:
//   pnpm nx run api-db:prisma-migrate --name=<change>

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Applets (each applet's models live in its own schema file)
  plannerTasks    PlannerTask[]
  englishWords    EnglishWord[]
  englishProgress EnglishWordProgress[]
  englishDays     EnglishReviewDay[]
  healthProfile   HealthProfile?
  workoutLogs     WorkoutLog[]
  mealLogs        MealLog[]
  mealPlans       MealPlan[]

  @@map("users")
}
