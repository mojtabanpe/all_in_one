/// A Telegram private chat linked to one account (directive 168). One chat per account, one account per chat.
model TelegramLink {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId BigInt @unique
  /// Language of the bot's replies, taken from the app when the link was made.
  language String @default("fa") @db.VarChar(2)
  /// Tehran day of the last morning summary, so one goes out per day.
  lastSummaryDay String? @db.VarChar(10)
  /// Tehran day of the last card-review reminder, so at most one goes out per day (PG-012).
  lastReviewReminderDay String? @db.VarChar(10)
  /// Version of the reply keyboard this chat last got (MENU_VERSION in the bot); older ones get the new one.
  menuVersion Int @default(0)
  vpnMenuVisible Boolean @default(false)
  /// The running shadowing practice in Telegram: title, sentences, current index and per-sentence scores.
  shadow Json?
  /// What the bot waits for in the next message (a meal, an expense, a weight, a writing answer…) and when it asked.
  pending Json?
  createdAt DateTime @default(now())
  @@map("telegram_links")
}

/// One-time code in the `t.me/<bot>?start=<code>` link; only its SHA-256 is stored, valid 10 minutes.
model TelegramLinkCode {
  codeHash String @id
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  language String @default("fa") @db.VarChar(2)
  /// Offer surface that requested this link (`review_end` | `notify_failed`), or null elsewhere (PG-012).
  entry String? @db.VarChar(24)
  expiresAt DateTime
  @@index([userId])
  @@map("telegram_link_codes")
}

/// Daily aggregate Telegram funnel and reminder counts with no userId, chatId or personal data (PG-012).
model TelegramDailyCount {
  day String @db.VarChar(10)
  /// `linked` or `reminder_sent`.
  kind String @db.VarChar(24)
  /// Offer entry for `linked` (`review_end`, `notify_failed`, or `""` when unset); `""` for `reminder_sent`.
  entry String @default("") @db.VarChar(24)
  count Int @default(0)

  @@id([day, kind, entry])
  @@map("telegram_daily_counts")
}
