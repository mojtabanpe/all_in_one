/// A paid plan. Amounts are Rial (Zibal's unit); the UI shows Toman. Admins set prices; nothing is seeded,
/// and only active plans can be bought.
model BillingPlan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  titleFa   String   @db.VarChar(60)
  titleEn   String   @db.VarChar(60)
  months    Int
  priceRial Int
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    BillingOrder[]

  @@map("billing_plans")
}

enum BillingOrderStatus {
  PENDING
  PAID
  FAILED
}

/// One checkout. Plan, months and amount are copied at creation so a later price change never alters it.
/// Financial record: deleting a user with orders is refused.
model BillingOrder {
  id         String             @id @default(uuid(7)) @db.Uuid
  userId     String             @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId     String             @db.Uuid
  plan       BillingPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  months     Int
  amountRial Int
  status     BillingOrderStatus @default(PENDING)
  /// Zibal's payment reference, set once the gateway accepts the request.
  trackId    String?            @unique @db.VarChar(32)
  refNumber  String?            @db.VarChar(64)
  paidAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId, createdAt])
  @@map("billing_orders")
}

/// Paid access until `paidUntil`; each verified order extends it from max(now, paidUntil).
model BillingSubscription {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidUntil DateTime
  updatedAt DateTime @updatedAt

  @@map("billing_subscriptions")
}

enum BillingAdjustmentAction {
  EXTEND
  END
}

/// Audit trail of an admin changing someone's paid access by hand. Rows are never edited or deleted.
model BillingAdjustment {
  id            String                  @id @default(uuid(7)) @db.Uuid
  userId        String                  @db.Uuid
  user          User                    @relation("BillingAdjustmentUser", fields: [userId], references: [id], onDelete: Restrict)
  adminId       String                  @db.Uuid
  admin         User                    @relation("BillingAdjustmentAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  action        BillingAdjustmentAction
  days          Int?
  reason        String                  @db.VarChar(200)
  previousUntil DateTime?
  newUntil      DateTime
  createdAt     DateTime                @default(now())

  @@index([userId, createdAt])
  @@map("billing_adjustments")
}

enum BillingRewardCampaign {
  TELEGRAM_JOIN
  INSTAGRAM_FOLLOW
}

/// A verified non-payment reward. Each account can earn each campaign once.
model BillingReward {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @db.Uuid
  user      User @relation("BillingRewardUser", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String @db.Uuid
  admin     User @relation("BillingRewardAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  campaign  BillingRewardCampaign
  reason    String @db.VarChar(200)
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, campaign])
  @@map("billing_rewards")
}
