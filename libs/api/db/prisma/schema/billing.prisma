/// A paid plan. Amounts are Rial (Zibal's unit); the UI shows Toman. Admins set prices; nothing is seeded,
/// and only active plans can be bought.
model BillingPlan {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(32)
  titleFa   String   @db.VarChar(60)
  titleEn   String   @db.VarChar(60)
  months    Int
  priceRial Int
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    BillingOrder[]

  @@map("billing_plans")
}

enum BillingOrderStatus {
  PENDING
  PAID
  FAILED
  /// The whole amount was returned (see BillingRefund).
  REFUNDED
}

/// Where an order was paid: Zibal on the web and the direct APK, or a store's in-app billing in the store builds.
enum BillingProvider {
  ZIBAL
  BAZAAR
  MYKET
}

/// One checkout. Plan, months and amount are copied at creation so a later price change never alters it.
/// Financial record: deleting a user with orders is refused.
model BillingOrder {
  id         String             @id @default(uuid(7)) @db.Uuid
  userId     String             @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId     String             @db.Uuid
  plan       BillingPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  months     Int
  amountRial Int
  status     BillingOrderStatus @default(PENDING)
  /// Zibal's payment reference, set once the gateway accepts the request.
  trackId    String?            @unique @db.VarChar(32)
  refNumber  String?            @db.VarChar(64)
  provider   BillingProvider    @default(ZIBAL)
  /// A store purchase token (Bazaar, Myket). Unique per store, so one purchase activates at most once.
  purchaseToken String?         @db.VarChar(512)
  paidAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  refund     BillingRefund?

  @@unique([provider, purchaseToken])
  @@index([userId, createdAt])
  @@map("billing_orders")
}

/// Paid access until `paidUntil`; each verified order extends it from max(now, paidUntil).
model BillingSubscription {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidUntil DateTime
  /// The paidUntil an expiry SMS was sent for, so each period gets one notice.
  expiryNoticeFor DateTime?
  updatedAt DateTime @updatedAt

  @@map("billing_subscriptions")
}

enum BillingAdjustmentAction {
  EXTEND
  END
  /// Paid time taken back because its order was refunded.
  REFUND
}

/// Money returned for a paid order, at most once per order (whole or partial). Zibal has no refund API we
/// rely on: the admin returns the money in the Zibal panel or by bank transfer and records it here with its
/// reference. Any change to paid access is written as a REFUND row of billing_adjustments. Never edited.
model BillingRefund {
  id            String       @id @default(uuid(7)) @db.Uuid
  orderId       String       @unique @db.Uuid
  order         BillingOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adminId       String       @db.Uuid
  admin         User         @relation("BillingRefundAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  amountRial    Int
  reason        String       @db.VarChar(200)
  /// Zibal panel or bank tracking number.
  reference     String?      @db.VarChar(64)
  createdAt     DateTime     @default(now())

  @@index([createdAt])
  @@map("billing_refunds")
}

/// Audit trail of an admin changing someone's paid access by hand. Rows are never edited or deleted.
model BillingAdjustment {
  id            String                  @id @default(uuid(7)) @db.Uuid
  userId        String                  @db.Uuid
  user          User                    @relation("BillingAdjustmentUser", fields: [userId], references: [id], onDelete: Restrict)
  adminId       String                  @db.Uuid
  admin         User                    @relation("BillingAdjustmentAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  action        BillingAdjustmentAction
  days          Int?
  reason        String                  @db.VarChar(200)
  previousUntil DateTime?
  newUntil      DateTime
  createdAt     DateTime                @default(now())

  @@index([userId, createdAt])
  @@map("billing_adjustments")
}

enum BillingRewardCampaign {
  TELEGRAM_JOIN
  INSTAGRAM_FOLLOW
  /// Automatic: the account confirmed its second contact, a phone for email accounts or an email for phone-only ones (directive 121).
  SECOND_CONTACT
  /// Automatic (directive 183): a friend this account invited did a first real action; one row per friend (`key`).
  REFERRAL_INVITER
  /// Automatic (directive 183): this account joined through an invitation and did a first real action.
  REFERRAL_INVITED
}

/// A verified non-payment reward. Each account can earn each campaign once.
model BillingReward {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @db.Uuid
  user      User @relation("BillingRewardUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Null for an automatic week (SECOND_CONTACT).
  adminId   String? @db.Uuid
  admin     User? @relation("BillingRewardAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  campaign  BillingRewardCampaign
  reason    String @db.VarChar(200)
  startsAt  DateTime
  expiresAt DateTime
  /// Tells repeatable weeks apart: the invited friend's id for REFERRAL_INVITER, empty for every other campaign.
  key       String @default("") @db.VarChar(40)
  createdAt DateTime @default(now())

  @@unique([userId, campaign, key])
  @@map("billing_rewards")
}

/// Pending membership check; the handle is removed when the request is decided.
model BillingRewardRequest {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign  BillingRewardCampaign
  handle    String @db.VarChar(32)
  createdAt DateTime @default(now())

  @@unique([userId, campaign])
  @@index([createdAt])
  @@map("billing_reward_requests")
}

/// One invitation (directive 183): the invited account, who invited it and when both weeks were granted.
/// An account is invited at most once; an inviter earns at most `REFERRAL_MAX_WEEKS` weeks.
model Referral {
  inviteeId  String    @id @db.Uuid
  invitee    User      @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviterId  String    @db.Uuid
  inviter    User      @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  /// Set once the invited account did a first real action and the weeks were queued.
  rewardedAt DateTime?

  @@index([inviterId])
  @@index([rewardedAt, createdAt])
  @@map("referrals")
}
