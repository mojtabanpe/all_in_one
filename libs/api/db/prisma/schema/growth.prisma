/// Limited pseudonymous acquisition events; no user/profile relationship.
model GrowthEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  visitorId String   @db.Uuid
  name      String   @db.VarChar(32)
  language  String   @db.VarChar(2)
  day       String   @db.VarChar(10)
  campaign  Json?
  milestoneKey String? @unique
  createdAt DateTime @default(now())

  // One visitor/event/day: retries and reloads do not inflate the funnel.
  @@unique([visitorId, name, day])
  @@index([day, name])
  @@map("growth_events")
}

enum GrowthAdminReport {
  SUMMARY
  CAMPAIGNS
  RETENTION
  CHURN
}

enum GrowthReportAction {
  VIEW
  EXPORT
}

/// Admin activity only. Actor IDs remain available if an admin account is deleted.
model GrowthReportAudit {
  id        String             @id @default(uuid(7)) @db.Uuid
  actorId   String             @db.Uuid
  report    GrowthAdminReport
  action    GrowthReportAction
  createdAt DateTime           @default(now())

  @@index([createdAt, id])
  @@map("growth_report_audit")
}
