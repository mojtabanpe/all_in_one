# /opt/all-in-one/shared/.env on the server (chmod 600). Never commit the real file.
# APP_ORIGINS, APP_PUBLIC_URL, MCP_PUBLIC_URL, DATABASE_URL and REDIS_URL come from compose.yml.

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Email (password reset, sign-up verification), e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=همه در یک <no-reply@poshtetgarm.ir>
REQUIRE_EMAIL_VERIFICATION=true

# AI: each user enters their own OpenAI-compatible urls and keys in the profile.
# Set true only if users may point them at addresses on this server or its network
# (e.g. the local 9Router at http://127.0.0.1:20128/v1); keep false on a public server.
AI_ALLOW_PRIVATE_URLS=false
# Encrypts the users' AI keys: openssl rand -base64 32
AI_KEYS_SECRET=
TTS_CACHE_TTL_SECONDS=86400

# ChatGPT connection: allowed OAuth callback hosts
MCP_REDIRECT_HOSTS=chatgpt.com,chat.openai.com
