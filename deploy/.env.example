# /opt/all-in-one/shared/.env on the server (chmod 600). Never commit the real file.
# APP_ORIGINS, APP_PUBLIC_URL, MCP_PUBLIC_URL, DATABASE_URL and REDIS_URL come from compose.yml.

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Email (password reset, sign-up verification), e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Poshtetgarm <no-reply@poshtetgarm.ir>
REQUIRE_EMAIL_VERIFICATION=true

# Poshtetgarm managed AI. Put real credentials in server secrets only.
# Enable private URLs only for a trusted operator-configured local gateway.
AI_ALLOW_PRIVATE_URLS=false
MANAGED_AI_CHAT_URL=
MANAGED_AI_CHAT_MODEL=
MANAGED_AI_CHAT_KEY=
MANAGED_AI_TTS_PROVIDER=openai
MANAGED_AI_TTS_URL=
MANAGED_AI_TTS_MODEL=
MANAGED_AI_TTS_SECONDARY_MODEL=
MANAGED_AI_TTS_KEY=
MANAGED_AI_STT_PROVIDER=openai
MANAGED_AI_STT_URL=
MANAGED_AI_STT_MODEL=
MANAGED_AI_STT_KEY=
TTS_CACHE_TTL_SECONDS=86400

# ChatGPT/Claude connection: extra OAuth callback hosts (chatgpt.com, chat.openai.com, claude.ai,
# claude.com and loopback are always allowed)
MCP_REDIRECT_HOSTS=

# Social rewards: turn on each offer only when its official page is ready.
BILLING_TELEGRAM_OFFER_ENABLED=false
BILLING_INSTAGRAM_OFFER_ENABLED=false
# Android store builds (docs/android-stores.fa.md): purchases are checked with the store before access is granted.
# Cafe Bazaar: a Pishkhan API key, or else an OAuth client with its refresh token. Myket: the verify access token.
BAZAAR_API_SECRET=
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=
MYKET_ACCESS_TOKEN=
# Only if the store apps ever get another package name.
# BILLING_ANDROID_PACKAGE=ir.poshtetgarm.poshtetgarm_hybrid
