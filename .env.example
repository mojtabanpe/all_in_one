# Copy to .env and adjust. Used by the api, Prisma and docker compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=all_in_one
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app@localhost:5432/all_in_one?schema=public
API_PORT=3333

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Web app origins (comma-separated); the first is used in emailed links unless APP_PUBLIC_URL is set.
# APP_ORIGINS=https://poshtetgarm.ir
# APP_PUBLIC_URL=https://poshtetgarm.ir/app

# Email for password reset and sign-up confirmation. Without SMTP_URL, development logs emails.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=پشتت گرم <no-reply@example.com>
# New accounts must confirm their email; set to false to skip (local testing only).
# REQUIRE_EMAIL_VERIFICATION=false

# AI: every user sets their own OpenAI-compatible chat / TTS / STT urls and keys in
# «حساب کاربری ← هوش مصنوعی». Allow urls on private addresses (a local gateway such as
# 9Router on 127.0.0.1:20128) only on a server whose users you trust:
# AI_ALLOW_PRIVATE_URLS=true
# AI_KEYS_SECRET=            (32 random bytes, base64; encrypts the users' keys)
# REDIS_URL=redis://127.0.0.1:6379   (optional speech audio cache)

# ChatGPT connection (MCP): public HTTPS origin of the api for OAuth discovery
# (required in production; development defaults to http://localhost:API_PORT). See docs/chatgpt-mcp.md.
# MCP_PUBLIC_URL=https://poshtetgarm.ir
# MCP_REDIRECT_HOSTS=chatgpt.com,chat.openai.com

# Planner: allow calendar (ICS) feeds on private addresses. Local testing only.
# PLANNER_ICS_ALLOW_PRIVATE=false

# Web Push: generate once with `pnpm exec web-push generate-vapid-keys --json`.
# Keep the private key secret and preserve both keys across deployments.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@poshtetgarm.ir

# Native Android/macOS push: Firebase service-account JSON, server-only.
# Leave unset until a Firebase project exists. Never put this in a native build.
# FCM_SERVICE_ACCOUNT_JSON=
