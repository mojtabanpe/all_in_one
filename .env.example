# Copy to .env and adjust. Used by the api, Prisma and docker compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=all_in_one
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app@localhost:5432/all_in_one?schema=public
API_PORT=3333

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Web app origins (comma-separated); the first is used in emailed links unless APP_PUBLIC_URL is set.
# APP_ORIGINS=https://poshtetgarm.ir
# APP_PUBLIC_URL=https://poshtetgarm.ir/app

# Email for password reset and sign-up confirmation. Without SMTP_URL, development logs emails.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=Poshtetgarm <no-reply@example.com>
# New accounts must confirm their email; set to false to skip (local testing only).
# REQUIRE_EMAIL_VERIFICATION=false

# Poshtetgarm managed AI. Put real credentials in server secrets only.
# Enable private URLs only for a trusted operator-configured local gateway.
AI_ALLOW_PRIVATE_URLS=false
# Folder with the AI scope check's local model (set in the api image). Empty in development: downloaded once.
AI_SCOPE_MODEL_DIR=
# The local scope model needs ~400 MB RAM; it runs only when this is "on" (otherwise requests pass unchecked).
AI_SCOPE_LOCAL_MODEL=off
MANAGED_AI_CHAT_URL=
MANAGED_AI_CHAT_MODEL=
MANAGED_AI_CHAT_KEY=
MANAGED_AI_TTS_PROVIDER=openai
MANAGED_AI_TTS_URL=
MANAGED_AI_TTS_MODEL=
MANAGED_AI_TTS_SECONDARY_MODEL=
MANAGED_AI_TTS_KEY=
MANAGED_AI_STT_PROVIDER=openai
MANAGED_AI_STT_URL=
MANAGED_AI_STT_MODEL=
MANAGED_AI_STT_KEY=
# REDIS_URL=redis://127.0.0.1:6379   (optional speech audio cache)

# ChatGPT connection (MCP): public HTTPS origin of the api for OAuth discovery
# (required in production; development defaults to http://localhost:API_PORT). See docs/chatgpt-mcp.md.
# MCP_PUBLIC_URL=https://poshtetgarm.ir
# Extra OAuth redirect hosts (ChatGPT and Claude are always allowed):
# MCP_REDIRECT_HOSTS=

# Planner: allow calendar (ICS) feeds on private addresses. Local testing only.
# PLANNER_ICS_ALLOW_PRIVATE=false

# Web Push: generate once with `pnpm exec web-push generate-vapid-keys --json`.
# Keep the private key secret and preserve both keys across deployments.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@poshtetgarm.ir

# Native Android/macOS push: Firebase service-account JSON, server-only.
# Leave unset until a Firebase project exists. Never put this in a native build.
# FCM_SERVICE_ACCOUNT_JSON=
# First-party acquisition analytics, enabled without an end-user control.
GROWTH_ANALYTICS_ENABLED=true

# Server-only Zibal merchant. Set the real value only in secrets/local .env.
ZIBAL_MERCHANT=
ZIBAL_SANDBOX=false
# Zibal returns the browser here; the api verifies the order and redirects to /app/billing.
ZIBAL_CALLBACK_URL=https://poshtetgarm.ir/api/payments/callback

# Social rewards: turn on each offer only when its official page is ready.
BILLING_TELEGRAM_OFFER_ENABLED=false
BILLING_INSTAGRAM_OFFER_ENABLED=false

# Faraz SMS (api.iranpayamak.com, key from the Faraz panel). Off unless SMS_ENABLED=true and the key is set; put the real key only in server
# secrets. Templates and the sender line are in code (directive 88); FARAZ_SMS_SENDER replaces the line.
SMS_ENABLED=false
FARAZ_SMS_API_KEY=
# FARAZ_SMS_SENDER=3000505
