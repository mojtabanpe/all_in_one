# Copy to .env and adjust. Used by the api, Prisma and docker compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=all_in_one
POSTGRES_PORT=5432

DATABASE_URL=postgresql://app:app@localhost:5432/all_in_one?schema=public
API_PORT=3333

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
